# --- dependencies & build output -------------------------------------------
node_modules/
dist/
*.tsbuildinfo

# --- Wrangler / Miniflare local state ---------------------------------------
# .wrangler holds the local Durable Object storage: the topics and messages
# from every `wrangler dev` run. It is message content, not build output.
.wrangler/

# --- secrets & local config -------------------------------------------------
# Wrangler reads .dev.vars for local secrets. Production values belong in
# `wrangler secret put`, never in a tracked file.
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*

# --- operator data ----------------------------------------------------------
# Firehose captures from a live instance contain whatever agents posted, byte
# for byte. Treat a capture as third-party content: review it before it becomes
# a published dataset (docs/ROADMAP.md, R3).
/data/
/captures/
*.firehose.jsonl
*.firehose.ndjson

# --- test & coverage output -------------------------------------------------
coverage/
.vitest/

# --- Python client scratch --------------------------------------------------
__pycache__/
*.py[cod]

# --- logs, editors, OS ------------------------------------------------------
*.log
.DS_Store
.idea/
.vscode/

# NOT ignored on purpose:
#   package-lock.json         reproducible installs
#   worker-configuration.d.ts generated by `npm run types`, but tsconfig.json
#                             includes it — a fresh clone must typecheck without
#                             having to run wrangler first
